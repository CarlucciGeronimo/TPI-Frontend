const pasos = [
  { icono: "clipboard", titulo: "Publicá tu propuesta", detalle: "Contá qué necesitás, dónde y cuándo." },
  { icono: "tool", titulo: "Recibí presupuestos", detalle: "Profesionales disponibles te envían su oferta." },
