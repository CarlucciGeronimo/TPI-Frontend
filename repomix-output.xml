<file path="src/components/Segmentado.tsx">
import { Pressable, Text, View } from "react-native";

/*
  Selector segmentado
*/
type Opcion<T extends string> = { valor: T; etiqueta: string };

type Props<T extends string> = {
  opciones: readonly Opcion<T>[];
  valor: T;
  onCambio: (valor: T) => void;
};

export function Segmentado<T extends string>({ opciones, valor, onCambio }: Props<T>) {
  return (
    <View className="flex-row gap-1 rounded-xl bg-neutral-100 p-1">
      {opciones.map((o) => {
        const activa = o.valor === valor;
        return (
          <Pressable
            key={o.valor}
            onPress={() => onCambio(o.valor)}
            className={`h-10 flex-1 items-center justify-center rounded-lg ${activa ? "bg-black" : ""}`}
          >
            <Text className={`text-sm font-semibold ${activa ? "text-white" : "text-neutral-500"}`}>{o.etiqueta}</Text>
          </Pressable>
        );
      })}
    </View>
  );
}
</file>

<file path="src/components/ui.tsx">
import type { ReactNode } from "react";
import { Pressable, Text, View } from "react-native";
import { estadoLabel } from "../lib/format";

type Tono = { fondo: string; texto: string };

const positivo: Tono = { fondo: "bg-black", texto: "text-white" };
const neutro: Tono = { fondo: "bg-neutral-200", texto: "text-black" };
const negativo: Tono = { fondo: "border border-neutral-400 bg-white", texto: "text-neutral-500" };

const tono: Record<string, Tono> = {
  activa: positivo,
  disponible: positivo,
  aceptado: positivo,
  pendiente: neutro,
  ocupado: neutro,
  cancelada: negativo,
  cancelado: negativo,
  baja: negativo,
};

export function Estado({ valor }: { valor: string }) {
  const t = tono[valor] ?? neutro;
  return (
    <View className={`self-start rounded-full px-2.5 py-0.5 ${t.fondo}`}>
      <Text className={`text-xs font-semibold ${t.texto}`}>{estadoLabel[valor] ?? valor}</Text>
    </View>
  );
}

export function Tarjeta({ children, className = "" }: { children: ReactNode; className?: string }) {
  return <View className={`rounded-2xl border border-neutral-200 bg-white p-4 ${className}`}>{children}</View>;
}

export function Vacio({ children }: { children: ReactNode }) {
  return (
    <View className="rounded-2xl border border-dashed border-neutral-300 p-8">
      <Text className="text-center text-sm text-neutral-500">{children}</Text>
    </View>
  );
}

type PropsBotonChico = {
  etiqueta: string;
  onPress?: () => void;
  variante?: "solido" | "borde";
};

export function BotonChico({ etiqueta, onPress, variante = "solido" }: PropsBotonChico) {
  const solido = variante === "solido";
  return (
    <Pressable
      onPress={onPress}
      className={`h-9 items-center justify-center rounded-lg px-3 active:opacity-80 ${solido ? "bg-black" : "border border-neutral-400 bg-white"}`}
    >
      <Text className={`text-sm font-semibold ${solido ? "text-white" : "text-black"}`}>{etiqueta}</Text>
    </Pressable>
  );
}
</file>

<file path="src/context/RolContext.tsx">
import { createContext, useContext, useState, type ReactNode } from "react";
import { usuarios, type Rol, type Usuario } from "../mocks/data";

type RolContextValue = {
  rol: Rol;
  setRol: (rol: Rol) => void;
  usuario: Usuario;
};

const RolContext = createContext<RolContextValue | null>(null);

export function RolProvider({ children }: { children: ReactNode }) {
  const [rol, setRol] = useState<Rol>("usuario");
  const usuario = usuarios.find((u) => u.rol === rol) as Usuario;

  return <RolContext.Provider value={{ rol, setRol, usuario }}>{children}</RolContext.Provider>;
}

export function useRol() {
  const ctx = useContext(RolContext);
  if (!ctx) throw new Error("useRol debe usarse dentro de RolProvider");
  return ctx;
}
